# ------------------------------------------------------------------------
# Sécurité Apache — racine du site Les Éditions du Sucrier
# ------------------------------------------------------------------------

ErrorDocument 404 /404.html

# Désactiver le listing de répertoires
Options -Indexes

# Désactiver le suivi de symlinks dangereux (et restreindre à ceux du même propriétaire)
<IfModule mod_rewrite.c>
    Options +FollowSymLinks
</IfModule>

# Suivre HTTPS uniquement (forcer HTTPS si possible)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "(^\.|^(composer|package|package-lock|playwright)\.json$|\.example$|\.bak$|\.backup$|\.sqlite$|\.sqlite-.*$|\.jsonl$|\.log$|\.lock$|\.gitignore$|\.gitattributes$|\.env.*|.*\.md$|.*\.py$|router\.php$|sumup-config\.php$|config\.php$)">
    Require all denied
</FilesMatch>

# Bloquer l'accès aux fichiers commençant par .env, .git, .ht, etc.
RedirectMatch 403 (?i)^/?\.(env|git|ht|svn|idea|vscode)
RedirectMatch 403 (?i)^/?(package_upload_php|scripts|prototype_homepage|dist_release|deploy)(/|$)

# Empêcher l'exécution PHP dans data/, includes/, images/uploads/
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Headers de sécurité (complètent ceux envoyés par PHP via security.php)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always unset X-Powered-By
    Header unset Server
</IfModule>

# Cache long pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/json          "access plus 1 day"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# Cache-Control header (complement de mod_expires)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Compression GZIP : reduit la taille des reponses de 60-80%
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Compression Brotli si disponible (plus efficace que gzip)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# MIME type WebP au cas ou
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff .woff
    AddType font/woff2 .woff2
</IfModule>

# Limiter la taille des requêtes (10 Mo)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
