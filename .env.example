# Fichier d'exemple. Copier vers .env (qui est gitignoré) puis renseigner.
# En production : ces valeurs doivent être injectées comme variables d'environnement
# par l'hébergeur. Ne jamais committer .env.

# --- Backoffice ---
# Hash bcrypt du mot de passe admin (jamais le mot de passe en clair).
# Local : php scripts/setup_admin_password.php "votre-mot-de-passe"
# Prod  : même hash dans les variables d'environnement de l'hébergeur.
SUCRIER_ADMIN_PASSWORD_HASH=

# --- Site ---
SUCRIER_SITE_NAME="Les Editions du Sucrier"
# Local : http://localhost:8000  |  Production : https://www.votre-domaine.tld
SUCRIER_BASE_URL=https://www.votre-domaine.tld

# --- Contact / SMTP ---
SUCRIER_CONTACT_TO=leseditionsdusucrier@gmail.com
SUCRIER_CONTACT_FROM=no-reply@votre-domaine.tld
SUCRIER_SMTP_HOST=smtp.gmail.com
SUCRIER_SMTP_PORT=587
SUCRIER_SMTP_USERNAME=
SUCRIER_SMTP_PASSWORD=
SUCRIER_SMTP_ENCRYPTION=tls

# --- Base de données comptes clients (PostgreSQL en test/prod) ---
# Priorité : SUCRIER_AUTH_DSN, sinon SUPABASE_DB_DSN, sinon SQLite local (dev uniquement).
# Exemple hébergeur / Supabase :
#   SUCRIER_AUTH_DSN=pgsql:host=db.example.com;port=5432;dbname=sucrier_test;sslmode=require
SUCRIER_AUTH_DSN=
SUCRIER_AUTH_DB_USER=
SUCRIER_AUTH_DB_PASSWORD=
# Alias legacy (ignoré si SUCRIER_AUTH_DSN est renseigné)
SUPABASE_DB_DSN=

# --- Google OAuth (vérification audience côté serveur) ---
# Identifiant client OAuth Web (doit correspondre à celui utilisé côté front).
# En production, définir cette variable sur l'hébergeur. En local, si elle est
# absente, le serveur lit la même valeur dans google-auth-config.js à la racine.
SUCRIER_GOOGLE_CLIENT_ID=

# --- SumUp ---
SUCRIER_SUMUP_API_KEY=
SUCRIER_SUMUP_MERCHANT_CODE=
SUCRIER_WEBHOOK_SECRET=

# --- Origines de confiance (séparées par des virgules). Utilisé pour la
#     vérification anti-CSRF des APIs JSON. Ne pas inclure de wildcard. ---
# Local : http://localhost:8000,http://127.0.0.1:8000
SUCRIER_ALLOWED_ORIGINS=https://www.votre-domaine.tld,https://votre-domaine.tld
